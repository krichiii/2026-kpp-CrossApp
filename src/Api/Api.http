@Api_HostAddress = http://localhost:5115

# Перевірка працездатності сервісу (Health Check)
GET {{Api_HostAddress}}/health
Accept: application/json

# OpenAPI v1 документ (JSON)
GET {{Api_HostAddress}}/openapi/v1.json
Accept: application/json

# Scalar UI документація (v1)
GET {{Api_HostAddress}}/scalar/v1

# Отримати всі товари (List)
GET {{Api_HostAddress}}/api/products
Accept: application/json

# Створити новий товар (Create - POST)
POST {{Api_HostAddress}}/api/products
Content-Type: application/json

{
  "sku": "PRD-001",
  "name": "Кабель мережевий UTP Cat 5e",
  "unit": "м",
  "quantity": 150
}

# Отримати товар за ідентифікатором (Read - GET)
# Вказати дійсний id
@productId = d7a437c6 
GET {{Api_HostAddress}}/api/products/{{productId}}
Accept: application/json

# Оновити товар (Update - PUT)
PUT {{Api_HostAddress}}/api/products/{{productId}}
Content-Type: application/json

{
  "sku": "PRD-001-UPD",
  "name": "Кабель мережевий UTP Cat 6 (оновлений)",
  "unit": "м",
  "quantity": 200
}

# Видалити товар (Delete - DELETE)
DELETE {{Api_HostAddress}}/api/products/{{productId}}

# Спроба створити невалідний товар (400 ValidationProblem)
POST {{Api_HostAddress}}/api/products
Content-Type: application/json

{
  "sku": "",
  "name": "",
  "unit": "",
  "quantity": -10
}

# Перевірка винятку без stack trace для клієнта (500 ProblemDetails)
GET {{Api_HostAddress}}/throw
Accept: application/json
